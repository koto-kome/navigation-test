{
  "configurations": [
    {
      "name": "Arduino ESP32 (M5Stack)",
      "includePath": [
        "${workspaceFolder}/**",
        "${env:LOCALAPPDATA}/Arduino15/packages/m5stack/hardware/esp32/3.3.7/**",
        "${env:LOCALAPPDATA}/Arduino15/packages/m5stack/tools/**",
        "${env:USERPROFILE}/OneDrive/ドキュメント/Arduino/libraries/**"
