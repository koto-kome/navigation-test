      "defines": [
        "ARDUINO_ARCH_ESP32",
        "ESP32"
      ],
      "compilerPath": "${env:LOCALAPPDATA}/Arduino15/packages/m5stack/tools/esp-x32/2601/bin/xtensa-esp32-elf-g++.exe",
      "cppStandard": "c++17",
      "intelliSenseMode": "windows-gcc-x64"
    }
  ],
  "version": 4
}